#!/bin/sh
# Block a commit that adds a secret. Turn it on once per clone (it covers every branch and worktree):
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Commit blocked." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --verbose --no-banner --log-level warn
